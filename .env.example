# Supabase (siehe docs/deployment.md, A2)
# Pooler-URL (Laufzeit): connection_limit=1 nicht vergessen
DATABASE_URL="postgresql://postgres.<ref>:PW@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direkte URL (Migrationen)
DIRECT_URL="postgresql://postgres:PW@db.<ref>.supabase.co:5432/postgres"

# Upstash Redis — instanzuebergreifendes Login-Rate-Limit (US-15).
# Ohne diese Variablen greift automatisch der prozesslokale Fallback-Zaehler.
# Redis.fromEnv() liest genau diese Namen (nicht umbenennen).
UPSTASH_REDIS_REST_URL="https://eu2-xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AX..."

# Lokale Entwicklung: Pfad zu einem Chromium fuer den PDF-Export
# (in Produktion liefert @sparticuz/chromium die Binary).
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"
