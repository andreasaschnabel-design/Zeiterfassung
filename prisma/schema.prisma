// Zeiterfassung — Prisma-Schema
//
// Aufbau Story fuer Story (CLAUDE.md, Umsetzungsreihenfolge). Dieses Schema
// enthaelt aktuell nur die fuer US-01 (Auth + Rollen) noetigen Modelle.
// Weitere Modelle (TimeEntry, AuditLog, SecurityLog, Setting) sowie die
// Rueckrelationen an User kommen mit ihren jeweiligen Stories hinzu.
//
// DE-06: Sessions sind opak. Es wird nur der sha256(token) als Session.id
// gespeichert, niemals der Token selbst (siehe lib/auth/session.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  name              String
  role              Role     @default(EMPLOYEE)
  hourlyRate        Decimal  @default(13.90) @db.Decimal(5, 2)
  monthlyLimitHours Decimal  @default(40) @db.Decimal(5, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  sessions    Session[]
  timeEntries TimeEntry[]
  auditLogs   AuditLog[]  @relation("AuditActor")
}

model TimeEntry {
  id              String    @id @default(cuid())
  userId          String
  workDate        DateTime  @db.Date // DE-02: reines Datum ohne Zeitzone
  startTime       String // "HH:MM"
  endTime         String // "HH:MM"
  breakMinutes    Int
  durationMinutes Int // DE-01: persistiert, nicht nur berechnet
  note            String?
  deletedAt       DateTime? // DE-04: Soft-Delete
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String

  user      User       @relation(fields: [userId], references: [id])
  auditLogs AuditLog[]

  @@index([userId, workDate])
  @@index([deletedAt])
}

model AuditLog {
  id          String      @id @default(cuid())
  timeEntryId String
  changedById String
  action      AuditAction
  oldValues   Json?
  newValues   Json?
  changedAt   DateTime    @default(now())

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id])
  changedBy User      @relation("AuditActor", fields: [changedById], references: [id])

  @@index([timeEntryId, changedAt])
}

model Session {
  id        String   @id // sha256(token), nie der Token selbst
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// US-10/AK-6: Globale Parameter als key/value.
// Schluessel: minimumWage (13.90), earningsLimit (556), employerName.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
